def reportPipelineStatus(String callbackStatus, String imageReference = "") {
  if (!params.PIPELINE_RUN_ID?.trim()) {
    echo "Skip DevFlow callback because PIPELINE_RUN_ID is empty"
    return
  }

  withCredentials([
    string(
      credentialsId: "devflow-pipeline-callback-token",
      variable: "DEVFLOW_CALLBACK_TOKEN"
    )
  ]) {
    withEnv([
      "DEVFLOW_CALLBACK_STATUS=${callbackStatus}",
      "DEVFLOW_CALLBACK_IMAGE_REFERENCE=${imageReference}"
    ]) {
      sh '''
        set -eu
        callback_url="${DEVFLOW_CALLBACK_BASE_URL%/}/api/v1/pipeline-runs/${PIPELINE_RUN_ID}/status"
        if [ -n "${DEVFLOW_CALLBACK_IMAGE_REFERENCE:-}" ]; then
          callback_payload="$(printf '{"status":"%s","image_reference":"%s"}' "${DEVFLOW_CALLBACK_STATUS}" "${DEVFLOW_CALLBACK_IMAGE_REFERENCE:-}")"
        else
          callback_payload="$(printf '{"status":"%s"}' "${DEVFLOW_CALLBACK_STATUS}")"
        fi
        curl \
          --fail \
          --silent \
          --show-error \
          --retry 3 \
          --retry-delay 1 \
          --retry-all-errors \
          -X POST \
          "${callback_url}" \
          -H "Authorization: Bearer ${DEVFLOW_CALLBACK_TOKEN}" \
          -H "Content-Type: application/json" \
          --data "${callback_payload}" \
          > /dev/null
      '''
    }
  }
}

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timestamps()
    timeout(time: 30, unit: "MINUTES")
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: "PIPELINE_RUN_ID", defaultValue: "", description: "DevFlow Pipeline Run UUID")
    string(name: "GIT_COMMIT_SHA", defaultValue: "", description: "Git commit requested by DevFlow")
  }

  stages {
    stage("Checkout") {
      steps {
        checkout scm
        script {
          env.DEVFLOW_ACTUAL_COMMIT = sh(
            returnStdout: true,
            script: "git rev-parse HEAD"
          ).trim()
          env.DEVFLOW_IMAGE_REFERENCE = "${env.DEVFLOW_HARBOR_REGISTRY}/${env.DEVFLOW_HARBOR_PROJECT}/devflow-api:${env.DEVFLOW_ACTUAL_COMMIT}"
        }
        sh '''
          set -eu
          if [ -n "${GIT_COMMIT_SHA}" ] && [ "${GIT_COMMIT_SHA}" != "${DEVFLOW_ACTUAL_COMMIT}" ]; then
            echo "Requested commit does not match checked out commit"
            exit 1
          fi
          printf 'DEVFLOW_ACTUAL_COMMIT=%s\n' "${DEVFLOW_ACTUAL_COMMIT}"
          printf 'DEVFLOW_IMAGE_REFERENCE=%s\n' "${DEVFLOW_IMAGE_REFERENCE}"
        '''
      }
    }

    stage("Report Running") {
      steps {
        script {
          reportPipelineStatus("running")
        }
      }
    }

    stage("Build Image") {
      steps {
        sh '''
          set -eu
          docker build \
            --pull=false \
            --label "org.opencontainers.image.revision=${DEVFLOW_ACTUAL_COMMIT}" \
            --tag "${DEVFLOW_IMAGE_REFERENCE}" \
            .
          test "$(docker image inspect "${DEVFLOW_IMAGE_REFERENCE}" --format '{{.Config.User}}')" = '10001:10001'
        '''
      }
    }

    stage("Trivy Security Gate") {
      steps {
        sh '''
          set -eu
          rm -rf -- reports/trivy
          ci/scripts/trivy-gate.sh \
            . \
            "${DEVFLOW_IMAGE_REFERENCE}" \
            reports/trivy
        '''
      }
    }

    stage("Push Image") {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: "devflow-harbor-push",
            usernameVariable: "DEVFLOW_HARBOR_USERNAME",
            passwordVariable: "DEVFLOW_HARBOR_PASSWORD"
          )
        ]) {
          sh '''
            set -eu
            temporary_docker_config="$(mktemp -d)"
            export DOCKER_CONFIG="${temporary_docker_config}"
            trap 'rm -rf "${temporary_docker_config}"' EXIT
            printf '%s' "${DEVFLOW_HARBOR_PASSWORD}" |
              docker login "${DEVFLOW_HARBOR_REGISTRY}" \
                --username "${DEVFLOW_HARBOR_USERNAME}" \
                --password-stdin
            docker push "${DEVFLOW_IMAGE_REFERENCE}"
            docker logout "${DEVFLOW_HARBOR_REGISTRY}" > /dev/null
          '''
        }
      }
    }
  }

  post {
    success {
      script {
        reportPipelineStatus("succeeded", env.DEVFLOW_IMAGE_REFERENCE ?: "")
      }
    }
    failure {
      script {
        reportPipelineStatus("failed")
      }
    }
    aborted {
      script {
        reportPipelineStatus("cancelled")
      }
    }
    always {
      archiveArtifacts(
        artifacts: "reports/trivy/*.json",
        allowEmptyArchive: true,
        fingerprint: true
      )
      echo "DevFlow pipeline finished"
    }
  }
}
